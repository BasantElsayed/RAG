# انسخي الملف ده باسم secrets.toml (جوه نفس فولدر .streamlit) وحطي فيه
# القيم الحقيقية بتاعتكم. متعمليش commit لملف secrets.toml نفسه على GitHub.
#
# لو هتنشري على Streamlit Community Cloud: مش محتاجة الملف ده خالص محليًا --
# حطي نفس القيم دي في App settings -> Secrets من لوحة تحكم Streamlit Cloud.

WEAVIATE_URL = "https://xxxxxxx.weaviate.cloud"
WEAVIATE_API_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
COHERE_API_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_API_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
